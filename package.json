{
  "name": "dsh-ppt-studio",
  "version": "1.0.6",
  "description": "在 DeepSeek Harness 里做 PPT：说需求 → 逐页制作 → 导出可编辑的 .pptx。含布局检查、Office 真渲染复核，以及可扩展的本地模板库",
  "//publish": "2026-09-18 用户拍板改发 npm（dsh-web 维护者建议）+ 采用**无 scope** 包名 `dsh-ppt-studio`（现已可用；生态里 40+ 条社区插件同样是 dsh-* 无 scope 名，scope 名只用于个人用户名）。原先这里是 private:true（不发布 npm，只发 GitHub Release 资产）——那条路仍保留为离线/归档通道，见 docs/06 与 README §10。",
  "repository": { "type": "git", "url": "git+https://github.com/zbsph/dsh-ppt-studio.git" },
  "homepage": "https://github.com/zbsph/dsh-ppt-studio#readme",
  "bugs": { "url": "https://github.com/zbsph/dsh-ppt-studio/issues" },
  "keywords": ["dsh", "ppt", "pptx", "powerpoint", "slides", "deck", "presentation", "cordis", "plugin", "deepseek-harness"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./lib/index.js",
  "//lib": "lib/ 是**提交**的构建产物（src 的纯拷贝）：商店（创意工坊）对无 npm 包的条目生成的命令是 `dsh plugin add <repo URL>`，git 安装只拿得到已提交内容，lib 不入库则插件挂不上。守卫：npm run check:lib + smoke 断言。",
  "//dsh": "profile bundle 声明（2026-09-14）：让 `dsh plugin --profile <p> add <本包>` 装完即挂载——launcher 在 profile 里跑完 pnpm 后核对 dsh.profile.bundles，声明了 dsh.bundle 的依赖自动入栈。",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "templates",
    "docs",
    "skills",
    "scripts",
    "agent-presets",
    "cordis.patch.yml",
    "examples/smoke",
    "examples/fx",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-skill": ">=0.1.5-rc.2 <2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:node": "node scripts/build.mjs",
    "sync": "node scripts/release-sync.mjs",
    "test": "node scripts/build.mjs && node scripts/check-tracked-lf.mjs && node scripts/smoke.mjs && node scripts/check-preset.mjs",
    "check:eol": "node scripts/check-tracked-lf.mjs",
    "fresh": "node scripts/verify-fresh-install.mjs",
    "test:real": "node scripts/regression-real.mjs",
    "test:preflight": "node scripts/preflight-1.0.mjs",
    "test:preset": "node scripts/check-preset.mjs",
    "test:e2e": "node scripts/e2e-1.0.mjs",
    "test:bundle": "node scripts/verify-bundle-install.mjs",
    "check:lib": "node scripts/check-lib-freshness.mjs",
    "audit:facts": "node scripts/audit-manual-facts.mjs",
    "probe:effect": "node scripts/probe-effect-semantics.mjs",
    "probe:reparse": "node scripts/probe-reparse-safety.mjs",
    "probe:asset": "node scripts/probe-asset-freshness.mjs",
    "eval:skills": "node scripts/eval-skills-score.mjs"
  }
}
