node_modules/
# lib/ 是**提交**的构建产物（src 的纯拷贝，26 个文件 / 0.36MB）：
# 为什么提交：`dsh plugin --profile web add <本仓库 git URL>` 只拿得到 git 里已提交的内容，
# 而 package.json 的 exports 指向 ./lib/index.js——lib/ 不提交时，git 安装出来的包缺入口文件，
# 插件挂不上（2026-09-16 实测：装到的包没有 lib/）。提交后 git 安装与 tgz 安装产物一致。
# 守卫：`npm run check:lib` 与 smoke 断言（committed lib 必须逐字节等于 src）。
# 但生成物/临时目录仍在忽略之列：
*.tsbuildinfo
*.tgz
.sync-state.json

# 生成物/回归临时工程（脚本每次重建；保留手写 examples/smoke 源 yaml）
examples/smoke/preview/
examples/autodeclare-smoke/
examples/table-smoke/
examples/fx/*.pptx
examples/fx/ren-*/
examples/fx/reimport/
examples/smoke/imported/
examples/smoke/preview-rt/
examples/smoke/out-*.pptx
examples/smoke/media-test.png
examples/media-smoke/
examples/overlap-smoke/
examples/v3-smoke/
examples/scaffold-smoke/
examples/band-smoke/
examples/tpl-check-*/
examples/tpl-dbg-*/
examples/tpl-work/
examples/tpl-work-ext/
examples/tpl-preview-work/
examples/import-realtest/
examples/import-realtest2/
examples/import-realtest-regression/
templates/*/preview/
templates/*/previews/
templates/*/_cleanup-tmp/
examples/fx/*/preview/

# smoke/自检的临时目录（脚本正常会清理；崩过就残留，绝不能进版本库）
examples/**/.tmp-*/
# smoke 造的临时模板（同上：正常会自清，崩过就留下；名字都带 smoke- 前缀）
templates/smoke-*/

